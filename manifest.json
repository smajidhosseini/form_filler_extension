{
  "manifest_version": 3,
  "name": "Job Application Assistant — Workday",
  "version": "2.0.0",
  "description": "Fill job applications and draft cover letters from your resume with the OpenAI API.",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": ["https://api.openai.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Job Application Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["cv.pdf", "cv.tex"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
